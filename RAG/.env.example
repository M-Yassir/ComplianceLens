# Vector Database
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=ccpa_child_chunks

# Embedding Configuration
# Options: "gemini", "openai", "huggingface", "default"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_API_KEY=your_google_ai_studio_api_key_here
EMBEDDING_DIMENSION=768

# LLM Configuration
# Options: "gemini", "groq", "openai", "ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your_google_ai_studio_api_key_here