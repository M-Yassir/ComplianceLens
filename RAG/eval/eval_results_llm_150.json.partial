    "eval_id": "eval_7102_002",
    "query": "By what deadline each year must large-scale businesses compile and publish their annual CCPA request metrics, and where must these disclosures be published?",
    "target_section": "7102",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
