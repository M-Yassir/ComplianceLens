  {
    "eval_id": "eval_7150_004",
    "query": "When does automated profiling used to infer consumer intelligence, work performance, or health trigger a mandatory risk assessment?",
    "target_section": "7150",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
