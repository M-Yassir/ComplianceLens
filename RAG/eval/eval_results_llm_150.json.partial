  {
    "eval_id": "eval_7012_005",
    "query": "When is a registered data broker exempt from providing a Notice at Collection directly to consumers?",
    "target_section": "7012",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
    "section_hit": true,
    "hit_in_top_1": true,
    "precision_at_k": 0.3333,
    "key_term_recall": 0.4,
    "citation_valid": true,
    "ground_truth_answer": "Under \u00a7 7012(i), a registered data broker that collects personal information from a source other than directly from the consumer does not need to provide a Notice at Collection if its registration submission to the Attorney General includes a link to its online privacy policy with instructions on submitting opt-out requests.",
    "generated_answer": "Based on the provided regulatory text, a data broker registered with the Attorney General pursuant to Civil Code section 1798.99.80 et seq. is exempt from providing a Notice at Collection to the consumer under the following conditions:\n\n*   **Indirect Collection**: The data broker must collect the personal information from a source other than directly from the consumer (\u00a7 7012(i)).\n*   **Registration Disclosure**: The data broker must have included in its registration submission a link to its online privacy policy (\u00a7 7012(i)).\n*   **Opt-out Instructions**: The linked online privacy policy must include instructions on how a consumer can submit a request to opt-out of the sale or sharing of their personal information (\u00a7 7012(i)).",
