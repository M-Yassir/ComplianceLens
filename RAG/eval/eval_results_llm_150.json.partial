    "eval_id": "eval_7123_010",
    "query": "What controls over software/hardware inventories and unauthorized execution are mandated under \u00a7 7123(c)(4)?",
    "target_section": "7123",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
