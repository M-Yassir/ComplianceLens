    "eval_id": "eval_7150_003",
    "query": "Is a company required to perform a CCPA risk assessment if it uses video interviews and automated emotion-recognition AI to screen job applicants without human intervention?",
    "target_section": "7150",
    "expected_route": "HYBRID_BOTH",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": false,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
