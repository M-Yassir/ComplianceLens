    "eval_id": "eval_7120_001",
    "query": "What data processing volume thresholds trigger the requirement for a business to complete an annual CCPA cybersecurity audit under section 7120?",
    "target_section": "7120",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
