  {
    "eval_id": "eval_7222_007",
    "query": "What details regarding human involvement must be disclosed when explaining the outcome of an ADMT significant decision?",
    "target_section": "7222",
    "expected_route": "HYBRID_BOTH",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": false,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
