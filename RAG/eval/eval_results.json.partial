    "eval_id": "eval_7002_007",
    "query": "If a business decides to collect a new category of personal information that was not listed in its initial Notice at Collection, what step must it take before collecting that data?",
    "target_section": "7002",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
