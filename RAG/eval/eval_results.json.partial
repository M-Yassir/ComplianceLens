        "rerank_score": 0.0994,
        "snippet": "\u00a7 7001. Definitions.\n(e)\n\u201cAutomated decisionmaking technology\u201d or \u201cADMT\u201d means any technology\nthat processes personal information and uses computation to replace human\ndecisionmaki..."
      },
      {
        "parent_id": "v2026_sec7200_parent_all",
