  {
    "eval_id": "eval_7221_003",
    "query": "Can a business rely on a standard website cookie banner or cookie management tool as an acceptable method for handling ADMT opt-out requests?",
    "target_section": "7221",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
