  {
    "eval_id": "eval_7001_013",
    "query": "Does using Automated Decisionmaking Technology (ADMT) to serve targeted advertisements to a consumer constitute making a 'significant decision' under CCPA regulations?",
    "target_section": "7001",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
