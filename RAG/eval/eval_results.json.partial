    "eval_id": "eval_7001_002",
    "query": "Are standard IT infrastructure tools like firewalls, website loading software, spreadsheets, and anti-spam filters classified as Automated Decisionmaking Technology (ADMT) under active CCPA regulations?",
    "target_section": "7001",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": true,
    "section_hit": false,
    "hit_in_top_1": false,
    "precision_at_k": 0.0,
    "key_term_recall": null,
    "citation_valid": true,
    "ground_truth_answer": "No. ADMT explicitly excludes web hosting, domain registration, networking, caching, website-loading, data storage, firewalls, anti-virus, anti-malware, spam- and robocall-filtering, spellchecking, calculators, databases, and spreadsheets, provided that they do not replace human decisionmaking.",
    "generated_answer": "I am unable to answer your query based on the active CCPA/CPRA regulations in the current knowledge base. The retrieved regulatory texts did not contain sufficient relevant details to provide a reliable answer.",
