  {
    "eval_id": "eval_7025_004",
    "query": "What three specific user interface restrictions must a business satisfy to process an opt-out preference signal in a 'frictionless manner' under section 7025(f)?",
    "target_section": "7025",
    "expected_route": "POLICY_LOOKUP",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": true,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
    "abstained": false,
