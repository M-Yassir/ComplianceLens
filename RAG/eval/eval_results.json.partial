    "eval_id": "eval_7156_002",
    "query": "Can a business satisfy CCPA risk assessment requirements by using a Data Protection Impact Assessment (DPIA) prepared for another state's privacy law?",
    "target_section": "7156",
    "expected_route": "HYBRID_BOTH",
    "actual_route": "POLICY_LOOKUP",
    "route_correct": false,
    "route_reasoning": "Standard regulatory policy lookup targeting active 2026 regulations.",
    "answerable": true,
